{
  "name": "d1-prisma",
  "version": "1.1.1",
  "type": "module",
  "description": "Bridge CLI to manage Cloudflare D1 migrations with Prisma",
  "main": "./dist/index.js",
  "bin": {
    "d1-prisma": "dist/index.js"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "scripts": {
    "build": "bun build src/index.ts --format esm --clean --minify --target node --outdir ./dist",
    "dev": "bun src/index.ts --format esm --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "bun run build",
    "tsc:check": "tsc -b .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hiutaky/d1-prisma.git"
  },
  "bugs": {
    "url": "https://github.com/Hiutaky/d1-prisma/issues"
  },
  "homepage": "https://github.com/Hiutaky/d1-prisma#readme",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@prisma/adapter-d1": "^7.0.0",
    "@types/bun": "^1.3.13",
    "jiti": "^2.0.0",
    "jsonc-parse": "^2.0.0",
    "smol-toml": "^1.6.0",
    "tiny-parse-argv": "^2.8.2"
  },
  "peerDependencies": {
    "prisma": "^7.0.0",
    "wrangler": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "bun": "^1.3.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
